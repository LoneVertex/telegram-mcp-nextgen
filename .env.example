# Telegram application credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Use an authorized session string for non-interactive MCP operation.
TELEGRAM_SESSION_STRING=
# Or use a file session generated outside the server.
TELEGRAM_SESSION_NAME=telegram

# Tool exposure: core (safe read/search), standard (common sends), full (all 125 upstream tools).
# Default: core
TELEGRAM_MCP_TIER=core
# Legacy exposure filter remains available after tier filtering.
TELEGRAM_EXPOSED_TOOLS=all

# Fail-closed mutation controls. Both must be true for administrative/destructive tools.
TELEGRAM_SEND_ENABLED=false
TELEGRAM_DESTRUCTIVE_ENABLED=false

# Persistent state is kept outside the source tree.
TELEGRAM_DATA_DIR=~/.local/state/telegram-mcp
# Optional explicit overrides, all must remain under TELEGRAM_DATA_DIR.
# TELEGRAM_SESSION_DIR=~/.local/state/telegram-mcp/session
# TELEGRAM_CACHE_DIR=~/.local/state/telegram-mcp/cache
# TELEGRAM_MEDIA_DIR=~/.local/state/telegram-mcp/media
# TELEGRAM_EXPORTS_DIR=~/.local/state/telegram-mcp/exports
# TELEGRAM_DB_PATH=~/.local/state/telegram-mcp/cache/telegram.db

# Bounded media and search/sync limits.
MAX_MEDIA_DOWNLOAD_SIZE_MB=200
MAX_MEDIA_UPLOAD_SIZE_MB=200
TELEGRAM_MAX_SEARCH_LIMIT=100
TELEGRAM_SYNC_BATCH_SIZE=100

# FloodWait and transient-network retry policy.
TELEGRAM_FLOOD_MAX_RETRIES=4
TELEGRAM_FLOOD_MAX_SECONDS=3600
TELEGRAM_BACKOFF_BASE_SECONDS=1.0
TELEGRAM_RATE_CAPACITY=8
TELEGRAM_RATE_REFILL_PER_SECOND=2.0

# Optional multiple accounts use TELEGRAM_SESSION_STRING_<LABEL> / TELEGRAM_SESSION_NAME_<LABEL>.
# TELEGRAM_SESSION_STRING_WORK=
# TELEGRAM_SESSION_STRING_PERSONAL=
# For same-account concurrent clients, use a pool of separate authorized sessions.
# TELEGRAM_SESSION_STRINGS=<session-a> <session-b>

# Optional HTTP/SSE transport. Local stdio is the default.
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGINS=https://mcp.example.com

# File tools are deny-all unless client MCP Roots or explicit server roots are verified.
TELEGRAM_ALLOW_SERVER_ROOTS_FALLBACK=false

# Optional proxy/device settings are inherited from upstream compatibility support.
# TELEGRAM_PROXY_TYPE=socks5
# TELEGRAM_PROXY_HOST=127.0.0.1
# TELEGRAM_PROXY_PORT=1080
# TELEGRAM_DEVICE_MODEL=Telegram MCP
# TELEGRAM_SYSTEM_VERSION=1.0
# TELEGRAM_APP_VERSION=1.0
